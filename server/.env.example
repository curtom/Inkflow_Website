# 本地开发：可复制为 .env 与 .env.local；非 production 时先读 .env 再读 .env.local（后者覆盖前者）
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/inkflow
JWT_SECRET=change-me
# 多个前端域名用英文逗号分隔，例如：https://app.example.com,http://localhost:5173
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# 社区标签向量：国内通义千问（优先于 OpenAI）
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# 可选，text-embedding-v4：2048 / 1536 / 1024 / 768 / 512 / 256 / 128 / 64
# EMBEDDING_DIMENSIONS=1024

# 或使用 OpenAI（未配置 DASHSCOPE_API_KEY 时）
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

COMMUNITY_MATCH_MIN_SIMILARITY=0.35
# top1 与 top2 分差不足时不自动打标签，降低误判（建议 0.01~0.04）
COMMUNITY_MATCH_MIN_MARGIN=0.015
# 是否把作者已有标签拼进 embedding 文本（建议 false，避免人为标签干扰）
EMBEDDING_INCLUDE_EXISTING_TAGS=false
# 英文/中文轻量先验加权（建议 0.01~0.02）
COMMUNITY_LANGUAGE_PRIOR_BOOST=0.015

# 设为 true 时，每次社区标签分类会在服务端控制台打印 Top3 分组与分数
# COMMUNITY_CLASSIFIER_DEBUG=true

# 图片存储（服务端 /uploads/image 转存 Cloudinary；与客户端直连共用 cloud_name）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# —— 浏览器直传对象存储（文件不经 Node，需在客户端设 VITE_DIRECT_UPLOAD）——
# DIRECT_UPLOAD_PROVIDER=oss 或 cos；不设则不走 /uploads/presign
# 存储桶须配置 CORS：来源需包含线上前端与本地开发源，例如：
#   https://stefanxia.cn
#   http://localhost:5173
# 允许 Methods：GET, PUT, HEAD；允许 Headers：* 或至少 Content-Type
# OSS_PUBLIC_XXX / COS_PUBLIC_XXX 建议填已绑定存储桶的 CDN HTTPS 根地址（加速访问、无末尾 /）
#
# DIRECT_UPLOAD_PROVIDER=oss
# OSS_REGION=oss-cn-hangzhou
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_PUBLIC_BASE=https://img.example.com
# OSS_ENDPOINT=
#
# DIRECT_UPLOAD_PROVIDER=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=
# COS_PUBLIC_BASE=https://img.example.com
